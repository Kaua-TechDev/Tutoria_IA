# ══════════════════════════════════════════════════════════════════════
# Tutoria IA — variáveis de ambiente
# ══════════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores:
#     cp .env.example .env        (Windows: copy .env.example .env)
# O .env NAO vai para o GitHub (esta protegido pelo .gitignore).
# Variável em branco = usa o valor padrão indicado.


# ── Aplicação ─────────────────────────────────────────────────────────
# Ambiente que escolhe a classe de config.py:
#   development -> debug ligado (padrão)
#   production  -> debug desligado, cookies seguros e SECRET_KEY obrigatória
APP_ENV=development

# Chave que assina os cookies de sessão do Flask. Use um texto longo e
# aleatório; gere um com:  python -c "import secrets; print(secrets.token_hex(32))"
# Em produção ela é obrigatória — o app não sobe sem ela.
SECRET_KEY=troque-por-uma-chave-aleatoria


# ── Banco de dados ────────────────────────────────────────────────────
# Em branco = SQLite (padrão). O arquivo instance/tutoria.db e criado sozinho.
# Para usar MySQL, instale o PyMySQL (ver requirements.txt) e preencha assim:
#   DATABASE_URL=mysql+pymysql://root:senha@localhost/tutor_trilhas
DATABASE_URL=


# ── OpenAI ────────────────────────────────────────────────────────────
# Chave da API (https://platform.openai.com/api-keys).
# Em branco = modo de demonstração: o chat responde localmente, sem IA.
# Se a API falhar (timeout, limite de uso, chave inválida), o chat também
# cai no modo local em vez de quebrar.
OPENAI_API_KEY=

# Modelo usado nas respostas. Padrão: gpt-4o-mini.
OPENAI_MODEL=

# Segundos de espera por resposta antes de desistir. Padrão: 20.
OPENAI_TIMEOUT=

# Quantas vezes o SDK tenta de novo em falhas temporárias (429, 5xx,
# conexão), esperando entre as tentativas. Padrão: 2.
OPENAI_MAX_RETRIES=


# ── Rate limit ────────────────────────────────────────────────────────
# Onde os contadores de tentativas ficam guardados. Padrão: memória, que
# serve para um único processo. Com vários workers, use um Redis:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=
