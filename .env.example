# Copie este arquivo para .env e preencha os valores.
# O .env NAO vai para o GitHub (esta protegido pelo .gitignore).

# Chave da API da OpenAI.
# Se ficar em branco, o chat roda em modo de demonstracao, sem chamar a IA.
OPENAI_API_KEY=

# Chave de sessao do Flask. Use qualquer texto longo e aleatorio.
SECRET_KEY=troque-por-uma-chave-aleatoria

# Banco de dados.
# Em branco = SQLite (padrao). O arquivo instance/tutoria.db e criado sozinho.
# Para usar MySQL, instale o PyMySQL e preencha assim:
#   DATABASE_URL=mysql+pymysql://root:senha@localhost/tutor_trilhas
DATABASE_URL=
